<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>
    <property name="tabWidth" value="4"/>

    <!-- Tamanho máximo de linha: 160 (ignora package/import) -->
    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^package\s|^import\s"/>
    </module>

    <module name="TreeWalker">

        <!-- Indentação: 4 espaços -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>

        <!-- Chaves: mesma linha que a declaração (K&R style) -->
        <!-- SLIST excluído: permite getters/setters em uma linha -->
        <module name="LeftCurly">
            <property name="tokens"
                      value="ANNOTATION_DEF, CLASS_DEF, CTOR_DEF, ENUM_CONSTANT_DEF,
                             ENUM_DEF, INTERFACE_DEF, LAMBDA, LITERAL_CASE,
                             LITERAL_CATCH, LITERAL_DEFAULT, LITERAL_DO, LITERAL_ELSE,
                             LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_SWITCH,
                             LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE,
                             OBJBLOCK, STATIC_INIT"/>
        </module>
        <module name="RightCurly"/>
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
        </module>

        <!-- Espaços -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI, TYPECAST"/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC"/>
        </module>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>

        <!-- Imports: sem wildcard (*) -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>

        <!-- Blocos -->
        <module name="EmptyBlock"/>

        <!-- Boas práticas -->
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ArrayTypeStyle"/>
        <module name="OneStatementPerLine"/>

    </module>
</module>
